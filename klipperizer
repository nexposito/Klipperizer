#!/usr/bin/env bash
# ============================================================
#  Klipperizer — main menu and orchestration
#  Automated Klipper firmware flashing (CAN/USB)
#
#  Usage:
#    ./klipperizer                     → interactive menu (whiptail)
#    ./klipperizer --list              → list boards as JSON
#    ./klipperizer --flash <file.yaml> <can|usb>  → direct flash
# ============================================================
set -euo pipefail

BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export KLIPPERIZER_BASE="$BASEDIR"
# shellcheck source=lib/notify.sh detect.sh build.sh flash.sh
source "$BASEDIR/lib/notify.sh"
source "$BASEDIR/lib/detect.sh"
source "$BASEDIR/lib/build.sh"
source "$BASEDIR/lib/flash.sh"

KLIPPER_DIR="$BASEDIR/klipper"
KATAPULT_DIR="$BASEDIR/katapult"

need() { command -v "$1" >/dev/null 2>&1 || { echo "Missing: $1 — run: bash install.sh"; exit 1; }; }
for c in yq make git python3; do need "$c"; done

# ---------- First run: clone sources if missing ----------
if [ ! -d "$KLIPPER_DIR" ]; then
  warn "First run: cloning Klipper (may take a while)..."
  git clone --depth 1 https://github.com/Klipper3d/klipper "$KLIPPER_DIR"
fi
if [ ! -d "$KATAPULT_DIR" ]; then
  warn "Cloning Katapult..."
  git clone --depth 1 https://github.com/Arksine/katapult "$KATAPULT_DIR"
fi

list_boards() {
  # Output: JSON [{file, name, category}]
  local first=1
  echo "["
  while IFS= read -r f; do
    local name cat
    name=$(yq eval '.name' "$f" 2>/dev/null || echo "")
    cat=$(yq eval '.category' "$f" 2>/dev/null || echo "")
    [ -z "$name" ] || [ "$name" = "null" ] && continue
    [ $first -eq 1 ] && first=0 || echo ","
    printf '{"file": "%s", "name": "%s", "category": "%s"}' \
      "${f#$BASEDIR/}" "$name" "$cat"
  done < <(find "$BASEDIR/boards" -name '*.yaml' | sort)
  echo
  echo "]"
}

run_flash() {
  local profile="$1" mode="$2"
  case "$mode" in can|usb) ;; *) fatal "Invalid mode: $mode (use can or usb)" ;; esac
  [ -f "$profile" ] || fatal "Profile not found: $profile"

  # Hardware warnings from the profile (shown before any action)
  while IFS= read -r w; do
    [ -n "$w" ] && [ "$w" != "null" ] && warn "$w"
  done < <(yq eval '.hardware.warnings[]' "$profile" 2>/dev/null)

  build_firmware "$profile" "$mode" "$KLIPPER_DIR" "$KATAPULT_DIR"
  flash_board  "$profile" "$mode" "$KLIPPER_DIR" "$KATAPULT_DIR"
  success "Process finished."
}

# ---------- Non-interactive modes ----------
case "${1:-}" in
  --list)
    list_boards
    exit 0
    ;;
  --flash)
    [ $# -eq 3 ] || { echo "Usage: ./klipperizer --flash <profile.yaml> <can|usb>" >&2; exit 1; }
    run_flash "$2" "$3"
    exit 0
    ;;
esac

# ---------- Interactive menu (two steps: category → board) ----------
need whiptail

mapfile -t ARQS < <(find "$BASEDIR/boards" -name '*.yaml' | sort)
[ ${#ARQS[@]} -gt 0 ] || { echo "No profiles in boards/. Copy schema/boards.template.yaml."; exit 1; }

# Step 1 — board type (single column: readable labels only)
cat_label() {
  case "$1" in
    toolhead)          echo "Toolhead" ;;
    mainboard)         echo "Mainboard" ;;
    filament_changer)  echo "Filament changer" ;;
    inductive_probe)   echo "Inductive probe" ;;
    expansion_board)   echo "Expansion board" ;;
    adapter)           echo "USB-CAN adapter" ;;
    *)                 echo "$1" ;;
  esac
}

# Collect categories present in boards/ (sorted, unique)
mapfile -t CATS < <(
  for f in "${ARQS[@]}"; do yq eval '.category' "$f" 2>/dev/null; done \
    | grep -v '^null$' | grep -v '^$' | sort -u
)
[ ${#CATS[@]} -gt 0 ] || { echo "No valid categories in boards/ profiles."; exit 1; }

CAT_MENU=()
for c in "${CATS[@]}"; do
  CAT_MENU+=("$(cat_label "$c")" "")
done

CATEGORY_LABEL=$(whiptail --backtitle "Klipperizer" --title "Board type" \
  --menu "What kind of board are you flashing?" 0 0 0 "${CAT_MENU[@]}" \
  3>&1 1>&2 2>&3) || exit 0

# Map the displayed label back to the profile category key
CATEGORY=""
for c in "${CATS[@]}"; do
  if [ "$(cat_label "$c")" = "$CATEGORY_LABEL" ]; then
    CATEGORY="$c"
    break
  fi
done
[ -n "$CATEGORY" ] || { echo "Category not found: $CATEGORY_LABEL"; exit 1; }

# Step 2 — board within the chosen category (names only, no file paths)
FILTERED=()
NAMES=()
for f in "${ARQS[@]}"; do
  c=$(yq eval '.category' "$f" 2>/dev/null)
  if [ "$c" = "$CATEGORY" ]; then
    FILTERED+=("$f")
    NAMES+=("$(yq eval '.name' "$f")")
  fi
done
[ ${#FILTERED[@]} -gt 0 ] || { echo "No boards in category: $CATEGORY"; exit 1; }

BOARD_MENU=()
for n in "${NAMES[@]}"; do
  BOARD_MENU+=("$n" "")
done

SELECTED=$(whiptail --backtitle "Klipperizer" --title "Board selection" \
  --menu "Choose the board to flash:" 0 0 0 "${BOARD_MENU[@]}" \
  3>&1 1>&2 2>&3) || exit 0

PROFILE=""
for i in "${!NAMES[@]}"; do
  if [ "${NAMES[$i]}" = "$SELECTED" ]; then
    PROFILE="${FILTERED[$i]}"
    break
  fi
done
[ -n "$PROFILE" ] || { echo "Board not found: $SELECTED"; exit 1; }

# Step 3 — communication (single column: readable labels only)
MODE_LABEL=$(whiptail --backtitle "Klipperizer" --title "Communication" \
  --menu "How will the board '$SELECTED' communicate?" 0 0 0 \
  "CAN bus" "" "USB (serial)" "" \
  3>&1 1>&2 2>&3) || exit 0

case "$MODE_LABEL" in
  "CAN bus")      MODE=can ;;
  "USB (serial)") MODE=usb ;;
  *)              exit 0 ;;
esac

run_flash "$PROFILE" "$MODE"
